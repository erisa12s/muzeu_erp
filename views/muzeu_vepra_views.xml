<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PAMJA LISTË -->
    <record id="view_muzeu_vepra_tree" model="ir.ui.view">
        <field name="name">muzeu.vepra.list</field>
        <field name="model">muzeu.vepra</field>
        <field name="arch" type="xml">
            <list string="Veprat e Artit">
                <field name="name"/>
                <field name="artisti_id"/>
                <field name="lloji"/>
                <field name="salla_id"/>
                <field name="state" widget="badge" decoration-success="state == 'ekspozuar'" decoration-warning="state == 'ne_restaurim'" decoration-info="state == 'ne_ruajtje'"/>
            </list>
        </field>
    </record>

    <!-- PAMJA FORMULAR -->
    <record id="view_muzeu_vepra_form" model="ir.ui.view">
        <field name="name">muzeu.vepra.form</field>
        <field name="model">muzeu.vepra</field>
        <field name="arch" type="xml">
            <form string="Vepra e Artit">
                <sheet>
                    <!-- SMART BUTTON DËMTIMET -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_demtimet" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="demtimet_count" widget="statinfo" string="Dëmtime"/>
                        </button>
                    </div>

                    <field name="foto" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Emri i Veprës..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Detajet e Artit">
                            <field name="artisti_id"/>
                            <field name="lloji"/>
                            <field name="rryma"/>
                            <field name="vlera"/>
                        </group>
                        <group string="Vendndodhja &amp; Statusi">
                            <field name="kati_id"/>
                            <field name="salla_id"/>
                            <field name="state"/>
                            <field name="data_ekspozimit"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Përshkrimi">
                            <field name="pershkrim" placeholder="Shto histori ose përshkrim për këtë vepër..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION VEPRAT E ARTIT -->
    <record id="action_muzeu_vepra" model="ir.actions.act_window">
        <field name="name">Veprat e Artit</field>
        <field name="res_model">muzeu.vepra</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENYRAT KRYESORE TË MODULIT MUZEU -->
    <menuitem id="menu_muzeu_root" name="Muzeu ERP" web_icon="muzeu_erp,static/description/icon.png" sequence="10"/>

    <!-- MENYJA: EKSPOSITAT & ARTI -->
    <menuitem id="menu_muzeu_ekspozita" name="Ekspozita &amp; Vepra" parent="menu_muzeu_root" sequence="10"/>
    <menuitem id="menu_muzeu_vepra" name="Veprat e Artit" parent="menu_muzeu_ekspozita" action="action_muzeu_vepra" sequence="10"/>
    <menuitem id="menu_muzeu_artisti" name="Artistët" parent="menu_muzeu_ekspozita" action="action_muzeu_artisti" sequence="20"/>

    <!-- MENYJA: MENAXHIMI I DËMTIMEVE -->
    <menuitem id="menu_muzeu_demtimet_parent" name="Mirëmbajtja" parent="menu_muzeu_root" sequence="30"/>
    <menuitem id="menu_muzeu_demtimet" name="Dëmtimet &amp; Restaurimi" parent="menu_muzeu_demtimet_parent" action="action_muzeu_demtimet" sequence="10"/>
</odoo>