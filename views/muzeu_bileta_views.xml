<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. PAMJET (VIEWS) -->
    <record id="view_muzeu_bileta_list" model="ir.ui.view">
        <field name="name">muzeu.bileta.list</field>
        <field name="model">muzeu.bileta</field>
        <field name="arch" type="xml">
            <list string="Biletat">
                <field name="code"/>
                <field name="emri_vizitorit"/>
                <field name="lloji_biletes_id"/>
                <field name="cmimi"/>
                <field name="stafi_id"/>
                <field name="data_blerjes"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_muzeu_bileta_form" model="ir.ui.view">
        <field name="name">muzeu.bileta.form</field>
        <field name="model">muzeu.bileta</field>
        <field name="arch" type="xml">
            <form string="Bileta">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="emri_vizitorit"/>
                            <field name="lloji_biletes_id"/>
                            <field name="cmimi" readonly="1"/>
                        </group>
                        <group>
                            <field name="stafi_id"/>
                            <field name="kati_id"/>
                            <field name="data_blerjes"/>
                            <field name="state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 2. VEPRIMET (ACTIONS) -->
    <record id="action_muzeu_bileta" model="ir.actions.act_window">
        <field name="name">Biletat &amp; Kasa</field>
        <field name="res_model">muzeu.bileta</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_muzeu_lloji_biletes" model="ir.actions.act_window">
        <field name="name">Çmimet e Biletave</field>
        <field name="res_model">muzeu.lloji.biletes</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- 3. MENYTË DHE TË DREJTAT E AKSESIT -->
    <!-- Menuja Kryesore -->
    <menuitem id="menu_muzeu_root" name="Muzeu ERP"/>

    <!-- Menuja Kasa & Biletat (E hapur per te gjithe: Ana & Erisa) -->
    <menuitem id="menu_muzeu_biletat_root" name="Kasa &amp; Biletat" parent="menu_muzeu_root"/>
    <menuitem id="menu_muzeu_biletat" name="Prerje Biletash" parent="menu_muzeu_biletat_root" action="action_muzeu_bileta"/>

    <!-- Menuja Konfigurimi (E BLLOKUAR për Anën, E dukshme VETËM për Menaxherin) -->
    <menuitem id="menu_muzeu_config_root" name="Konfigurimi" parent="menu_muzeu_root" groups="muzeu_erp.group_muzeu_manager"/>

    <menuitem id="menu_muzeu_lloji_biletes" name="Çmimet e Biletave" parent="menu_muzeu_config_root" action="action_muzeu_lloji_biletes" groups="muzeu_erp.group_muzeu_manager"/>
</odoo>