<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PAMJA LISTË -->
    <record id="view_muzeu_bileta_list" model="ir.ui.view">
        <field name="name">muzeu.bileta.list</field>
        <field name="model">muzeu.bileta</field>
        <field name="arch" type="xml">
            <list string="Biletat">
                <field name="code"/>
                <field name="vizitori_id"/>
                <field name="lloji_biletes_id"/>
                <field name="itinerari_id"/>
                <field name="cmimi"/>
                <field name="menyra_pageses"/>
                <field name="valuta"/>
                <field name="stafi_id"/>
                <field name="data_blerjes"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'paid'" decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- PAMJA FORMULAR -->
    <record id="view_muzeu_bileta_form" model="ir.ui.view">
        <field name="name">muzeu.bileta.form</field>
        <field name="model">muzeu.bileta</field>
        <field name="arch" type="xml">
            <form string="Bileta">
                <header>
                    <button name="%(action_report_muzeu_bileta)d" string="Printo Biletën" type="action" class="btn-primary"/>
                    <button name="action_paguaj" string="Konfirmo Pagesën" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_anullo" string="Anullo Biletën" type="object" invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,paid,cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informacioni i Biletës">
                            <field name="vizitori_id"/>
                            <field name="lloji_biletes_id"/>
                            <field name="cmimi" readonly="1"/>
                            <!-- Zgjedhja e Itinerarit mbush automatikisht Katet dhe Gidin -->
                            <field name="itinerari_id"/>
                            <field name="kati_ids" widget="many2many_tags" readonly="1"/>
                            <field name="stafi_id" readonly="1"/>
                        </group>
                        <group string="Detajet e Pagesës">
                            <field name="menyra_pageses"/>
                            <field name="valuta"/>
                            <field name="data_blerjes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_muzeu_bileta" model="ir.actions.act_window">
        <field name="name">Prerje Biletash &amp; Pagesa</field>
        <field name="res_model">muzeu.bileta</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>