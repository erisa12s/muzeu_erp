<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_muzeu_itinerari_form" model="ir.ui.view">
        <field name="name">muzeu.itinerari.form</field>
        <field name="model">muzeu.itinerari</field>
        <field name="arch" type="xml">
            <form string="Itinerari">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,aktiv,paaktiv"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="emri" placeholder="Emri i Turit (p.sh. Turi i Artit Antik)"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Të Dhënat e Turit">
                            <field name="stafi_id"/>
                            <field name="gjuha"/>
                            <field name="kohezgjatja"/>
                            <field name="kapaciteti"/>
                            <field name="nr_salla"/>
                        </group>
                        <group string="Struktura e Çmimeve">
                            <field name="cmimi_baze"/>
                            <field name="cmimi_student"/>
                            <field name="cmimi_femije"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sallat që Vizitohen (Radha)">
                            <field name="detaje_ids">
                                <list editable="bottom">
                                    <field name="radha"/>
                                    <field name="salla_id"/>
                                    <field name="kati_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_itinerari_tree" model="ir.ui.view">
        <field name="name">muzeu.itinerari.list</field>
        <field name="model">muzeu.itinerari</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="emri"/>
                <field name="stafi_id"/>
                <field name="gjuha"/>
                <field name="kohezgjatja"/>
                <field name="cmimi_baze"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_muzeu_itinerari" model="ir.actions.act_window">
        <field name="name">Itineraret &amp; Turet</field>
        <field name="res_model">muzeu.itinerari</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>