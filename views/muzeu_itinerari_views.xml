<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PAMJA LISTË -->
    <record id="view_muzeu_itinerari_list" model="ir.ui.view">
        <field name="name">muzeu.itinerari.list</field>
        <field name="model">muzeu.itinerari</field>
        <field name="arch" type="xml">
            <list string="Itineraret / Turet">
                <field name="name"/>
                <field name="kohezgjatja"/>
                <field name="cmimi_shtese"/>
                <field name="ciceron_id"/>
                <field name="kati_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- PAMJA FORMULAR -->
    <record id="view_muzeu_itinerari_form" model="ir.ui.view">
        <field name="name">muzeu.itinerari.form</field>
        <field name="model">muzeu.itinerari</field>
        <field name="arch" type="xml">
            <form string="Itinerari">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Emri i Itinerarit (p.sh. Turi VIP)..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Detajet e Turit">
                            <field name="kohezgjatja"/>
                            <field name="cmimi_shtese"/>
                            <field name="ciceron_id"/>
                        </group>
                        <group string="Aksesi në Kat">
                            <field name="kati_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Përshkrimi i Turit">
                        <field name="pershkrimi" placeholder="Shto detaje mbi vendet që vizitohen..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_muzeu_itinerari" model="ir.actions.act_window">
        <field name="name">Itineraret &amp; Turet</field>
        <field name="res_model">muzeu.itinerari</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>