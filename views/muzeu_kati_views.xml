<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_muzeu_kati_tree" model="ir.ui.view">
        <field name="name">muzeu.kati.tree</field>
        <field name="model">muzeu.kati</field>
        <field name="arch" type="xml">
            <list string="Katet">
                <field name="name"/>
                <field name="niveli"/>
                <field name="nr_sallash"/>
            </list>
        </field>
    </record>

    <record id="view_muzeu_kati_form" model="ir.ui.view">
        <field name="name">muzeu.kati.form</field>
        <field name="model">muzeu.kati</field>
        <field name="arch" type="xml">
            <form string="Kati">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="niveli"/>
                        <field name="nr_sallash"/>
                    </group>
                    <notebook>
                        <page string="Sallat në këtë Kat">
                            <field name="salla_ids">
                                <list editable="bottom">
                                    <field name="nr"/>
                                    <field name="lloji"/>
                                    <field name="siperfaqe"/>
                                    <field name="kapaciteti"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_muzeu_kati" model="ir.actions.act_window">
        <field name="name">Katet</field>
        <field name="res_model">muzeu.kati</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
