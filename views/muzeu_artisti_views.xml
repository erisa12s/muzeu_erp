<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PAMJA LISTË -->
    <record id="view_muzeu_artisti_tree" model="ir.ui.view">
        <field name="name">muzeu.artisti.list</field>
        <field name="model">muzeu.artisti</field>
        <field name="arch" type="xml">
            <list string="Artistët">
                <field name="name"/>
                <field name="mbiemer"/>
                <field name="kombesia"/>
                <field name="periudha"/>
            </list>
        </field>
    </record>

    <!-- PAMJA FORMULAR -->
    <record id="view_muzeu_artisti_form" model="ir.ui.view">
        <field name="name">muzeu.artisti.form</field>
        <field name="model">muzeu.artisti</field>
        <field name="arch" type="xml">
            <form string="Artisti">
                <sheet>
                    <field name="foto" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Emri..."/>
                            <field name="mbiemer" placeholder="Mbiemri..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="kombesia"/>
                            <field name="periudha"/>
                        </group>
                        <group>
                            <field name="data_lindjes"/>
                            <field name="data_vdekjes"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Biografia">
                            <field name="biografia" placeholder="Shto biografinë e artistit..."/>
                        </page>
                        <page string="Veprat e Artit">
                            <field name="vepra_ids">
                                <list string="Veprat e këtij Artisti">
                                    <field name="name"/>
                                    <field name="salla_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION ARTISTËT -->
    <record id="action_muzeu_artisti" model="ir.actions.act_window">
        <field name="name">Artistët</field>
        <field name="res_model">muzeu.artisti</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>