<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_muzeu_artisti_tree" model="ir.ui.view">
        <field name="name">muzeu.artisti.list</field>
        <field name="model">muzeu.artisti</field>
        <field name="arch" type="xml">
            <list string="Artistët">
                <field name="name"/>
                <field name="mbiemer"/>
                <field name="shtetesia"/>
                <field name="datelindja"/>
            </list>
        </field>
    </record>

    <record id="view_muzeu_artisti_form" model="ir.ui.view">
        <field name="name">muzeu.artisti.form</field>
        <field name="model">muzeu.artisti</field>
        <field name="arch" type="xml">
            <form string="Artisti">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="mbiemer"/>
                        </group>
                        <group>
                            <field name="shtetesia"/>
                            <field name="datelindja"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Biografia">
                            <field name="biografia"/>
                        </page>
                        <page string="Veprat në Muze">
                            <field name="vepra_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="lloji"/>
                                    <field name="salla_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_muzeu_artisti" model="ir.actions.act_window">
        <field name="name">Artistët</field>
        <field name="res_model">muzeu.artisti</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>